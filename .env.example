ADDR=:8080
STORAGE_BACKEND=postgres
POSTGRES_DSN=postgres://watchtogether:watchtogether@postgres:5432/watchtogether?sslmode=disable
# Some platforms provide DATABASE_URL instead of POSTGRES_DSN.
# DATABASE_URL=
CACHE_BACKEND=redis
REDIS_ADDR=redis:6379
# REDIS_URL (rediss://...) overrides REDIS_ADDR when set.
# REDIS_URL=
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Server-side only. Configure in backend/Vercel environment variables; never expose
# this value to frontend build variables.
ABLY_ROOT_KEY=appId.keyId:keySecret
ABLY_TOKEN_TTL=30m
# 可选；未设置时与 ABLY_TOKEN_TTL 相同
# ABLY_JWT_TTL=30m
ABLY_CHANNEL_PREFIX=watchtogether
# Resend（仅服务端；未设置 RESEND_API_KEY 时不发信并打日志）
# RESEND_API_KEY=
EMAIL_FROM=WatchTogether <login@verify.bestlkl.top>
EMAIL_CODE_TTL=10m
EMAIL_CODE_LENGTH=6
EMAIL_CODE_SEND_INTERVAL=60s
EMAIL_CODE_DAILY_LIMIT=5
EMAIL_CODE_MAX_ATTEMPTS=5
# 房间聊天（Redis Stream + Ably，见 README）
# CHAT_STREAM_MAXLEN=2000
# CHAT_ABLY_PUBLISH_RETRY=2
# CHAT_ABLY_PUBLISH_TOTAL_TIMEOUT=10s
# CHAT_ABLY_PENDING_MAX=500
# CHAT_MAX_PAYLOAD_BYTES=61440
# CHAT_MAX_TEXT_RUNES=2000
# CHAT_RATE_PER_SECOND=10
STORAGE_DIR=/data/videos
POSTER_DIR=/data/posters
